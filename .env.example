# Required for /admin login & token signing
ADMIN_PASSWORD=change-me-admin-password
ADMIN_SECRET=change-me-to-a-long-random-32-byte-secret-string

# PostgreSQL connection string (Required on Render Free for persistent teams, frames & stats; optional locally)
# Example (Neon / Supabase): postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Server port (Render sets PORT automatically; defaults to 8888 locally)
PORT=8888

# Optional traffic gatekeeper & monitor configuration (defaults shown)
MAX_CONCURRENT=50
MAX_PER_IP=3
SESSION_TTL_SECONDS=60
START_LIMIT_PER_WINDOW=10
TIMEZONE=Asia/Manila

